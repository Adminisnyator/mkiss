#!/bin/sh
# vim:set ts=2 sw=2 et:

if [ $1 = "post-install" ]; then
  shift
  pkgname="$1"
  installdir="$2"

  if grep "/usr/share/mime/packages" $installdir/manifest > /dev/null 2>&1; then
    echo "Updating MIME type database..."
    env PKGSYSTEM_ENABLE_FSYNC=0 update-mime-database /usr/share/mime
  fi
fi
